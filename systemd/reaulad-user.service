[Unit]
Description=Reaula Hardware Driver Daemon (User Session)
Documentation=https://github.com/MizProject/reaula
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/reaulad --socket %t/reaula/reaulad.sock
Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStopSec=10s
KillMode=mixed

[Install]
WantedBy=default.target
