[Unit]
Description=Atrium Hardware Driver Daemon (User Session)
Documentation=https://github.com/MizProject/atrium
After=graphical-session.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/atriumd --socket %t/atrium/atriumd.sock
Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStopSec=10s
KillMode=mixed

[Install]
WantedBy=default.target
