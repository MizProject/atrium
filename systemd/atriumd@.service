[Unit]
Description=Atrium Hardware Driver Daemon for %i
Documentation=https://github.com/MizProject/atrium
After=local-fs.target systemd-udev-settle.service
Wants=systemd-udev-settle.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/bin/atriumd --allow-user %i --socket /run/atrium/atriumd.sock
RuntimeDirectory=atrium
RuntimeDirectoryMode=0700
StateDirectory=atrium
StateDirectoryMode=0700
Restart=on-failure
RestartSec=2s
WatchdogSec=30s
TimeoutStopSec=10s
KillMode=mixed
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
